{
  "name": "dash_kit",
  "version": "2.0.0",
  "description": "The dashboard grid dash_kit draws",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build": "esbuild app/javascript/dash_kit/dashboard_grid.jsx --bundle --minify --format=iife --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --alias:react=keystone_ui-react/src/react_on_page.js --alias:react-dom/client=keystone_ui-react/src/react_dom_on_page.js --alias:react-dom=keystone_ui-react/src/react_dom_on_page.js --alias:react/jsx-runtime=keystone_ui-react/src/jsx_runtime_on_page.js --outdir=app/assets/builds/dash_kit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylercschneider/dash_kit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/tylercschneider/dash_kit/issues"
  },
  "homepage": "https://github.com/tylercschneider/dash_kit#readme",
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "^3.2.4",
    "jsdom": "^27.0.1"
  },
  "type": "module",
  "dependencies": {
    "keystone_ui-blocks": "https://github.com/DYB-Development/keystone_ui-blocks/archive/refs/tags/v0.2.2.tar.gz",
    "keystone_ui-react": "https://github.com/DYB-Development/keystone_ui-react/archive/refs/tags/v0.1.3.tar.gz",
    "react-grid-layout": "2.2.4"
  }
}
